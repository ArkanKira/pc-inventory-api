{
  "info": {
    "name": "PC Inventory API",
    "description": "Complete collection for PC Inventory Management REST API. Auto-saves tokens and IDs as collection variables. Folders marked 'Day 4' will not work until the Product/StockMovement modules are implemented.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "adminToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "adminUserId", "value": "" },
    { "key": "staffUserId", "value": "" },
    { "key": "staffEmail", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "movementId", "value": "" }
  ],
  "item": [
    {
      "name": "00 — Health",
      "item": [
        {
          "name": "Health Check",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('success=true', () => pm.expect(pm.response.json().success).to.eql(true));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "Register Staff (auto-capture token)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('Role forced to staff', () => pm.expect(json.data.user.role).to.eql('staff'));",
                "pm.collectionVariables.set('staffToken', json.data.token);",
                "pm.collectionVariables.set('staffUserId', json.data.user._id);",
                "pm.collectionVariables.set('staffEmail', json.data.user.email);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Staff\",\n  \"email\": \"staff-{{$timestamp}}@example.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register tries to be admin (security)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.test('Role is staff, NOT admin', () => pm.expect(json.data.user.role).to.eql('staff'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacker\",\n  \"email\": \"hacker-{{$timestamp}}@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register duplicate email → 409",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 409', () => pm.response.to.have.status(409));",
                "pm.test('DUPLICATE_EMAIL', () => pm.expect(pm.response.json().error.code).to.eql('DUPLICATE_EMAIL'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ali Again\",\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"Password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register invalid input → 400",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 400', () => pm.response.to.have.status(400));",
                "pm.test('VALIDATION_ERROR', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"X\",\n  \"email\": \"not-email\",\n  \"password\": \"short\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login Admin (auto-capture token)",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Role is admin', () => pm.expect(json.data.user.role).to.eql('admin'));",
                "pm.collectionVariables.set('adminToken', json.data.token);",
                "pm.collectionVariables.set('adminUserId', json.data.user._id);"
              ]
